# Vite only exposes variables prefixed with VITE_ to the browser bundle, which
# is exactly the boundary you want: the client key belongs in the bundle, the
# server key never does.
#
# Get this from Settings -> API Keys in the SimpleLogs dashboard, and add
# http://localhost:5174 to the key's allowed origins.
VITE_SIMPLELOGS_CLIENT_KEY=ck_replace_me
